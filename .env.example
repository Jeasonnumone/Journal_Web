# ==================== 数据库配置 ====================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=journal_db
DB_USER=journal
DB_PASSWORD=journal123

# MySQL Root 密码
MYSQL_ROOT_PASSWORD=root123

# ==================== JWT 配置 ====================
# JWT 密钥（请修改为自己的密钥，至少32位）
JWT_SECRET=my-super-secret-key-for-jwt-production-change-this

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== MinIO 配置 ====================
# MinIO API 地址（容器内部使用 minio:9000）
MINIO_ENDPOINT=http://minio:9000
# MinIO Console 地址（外部访问）
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=journal

# ==================== Docker Hub 配置 ====================
# Docker Hub 用户名（用于拉取镜像）
DOCKER_USERNAME=your-docker-username

# ==================== 邮箱配置（可选） ====================
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_password

# ==================== Grafana 监控配置 ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_ROOT_URL=http://localhost:3000

# ==================== AlertManager 告警配置 ====================
# 告警接收邮箱
ALERT_EMAIL_TO=your_email@qq.com
# SMTP 发送方（通常与 MAIL_USERNAME 相同）
SMTP_FROM=your_email@qq.com
SMTP_USERNAME=your_email@qq.com
SMTP_PASSWORD=your_email_password
# Webhook 地址（可选，用于接入企业微信/钉钉等）
WEBHOOK_URL=